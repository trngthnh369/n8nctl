{
  "name": "@trngthnh369/n8n-workflow-validator",
  "version": "0.6.0",
  "description": "Offline validator for n8n workflow JSON — 6-layer checks (structural, referential, expressions, secrets, node sanity, parameter types).",
  "keywords": [
    "n8n",
    "validator",
    "workflow",
    "lint",
    "json-schema"
  ],
  "author": "Trường Thịnh <it01@emallvietnam.vn> (https://github.com/trngthnh369)",
  "license": "MIT",
  "homepage": "https://github.com/trngthnh369/n8nctl/tree/main/packages/n8n-workflow-validator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trngthnh369/n8nctl.git",
    "directory": "packages/n8n-workflow-validator"
  },
  "bugs": {
    "url": "https://github.com/trngthnh369/n8nctl/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./catalog": {
      "import": "./dist/catalog.js",
      "types": "./dist/catalog.d.ts"
    },
    "./node-catalog.json": "./node-catalog.json"
  },
  "bin": {
    "n8n-validate": "dist/cli.js"
  },
  "files": [
    "dist",
    "node-catalog.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
